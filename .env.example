# Shared development defaults
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Use your MongoDB Atlas connection string in production.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/drug_interaction_awareness
MONGO_URI=

# When true, the backend uses seeded in-memory data if MONGO_URI is not set.
DEMO_MODE=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional. openFDA works without a key at lower public rate limits.
OPENFDA_API_KEY=
